{
  "name": "dsh-tribot-team",
  "version": "1.2.1",
  "type": "module",
  "description": "TriBot Bot team for DeepSeek Harness: the /tribot skill (dispatcher / researcher / engineer / steward / reviewer) plus a visible role picker in the composer.",
  "license": "MIT",
  "author": "P3NN4L",
  "homepage": "https://www.npmjs.com/package/dsh-tribot-team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P3NN4L/dsh-tribot-team.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "skill",
    "agent",
    "prompt",
    "tribot"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "SKILL.md",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
